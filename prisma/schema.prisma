// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Para producción con PostgreSQL, cambiar a:
// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

model Financiador {
  id        String     @id @default(uuid())
  nombre    String
  consultas Consulta[]
  patients  Patient[]
  users     User[]
  onboardingCases OnboardingCase[]
  dataSources DataSource[]
}

model Afiliado {
  id        String     @id @default(uuid())
  dni       String     @unique
  nombre    String
  apellido  String
  edad      Int
  financiadorId String
  consultas Consulta[]
}

model Patient {
  id                String   @id @default(uuid())
  tipoDoc           String   // DNI, LC, LE, etc
  nroDoc            String
  nombre            String
  apellido          String
  fechaNac          DateTime
  sexo              String?  // M, F, Otro
  telefono          String?
  email             String?
  localidad         String?
  provincia         String?
  canalPreferido    String?  // guardia, programada, telemedicina
  
  // Cobertura
  financiadorId     String
  financiador       Financiador @relation(fields: [financiadorId], references: [id])
  planId            String?
  planNombre        String?
  nroAfiliado       String
  estadoCobertura   String   @default("activa") // activa, pausada, baja
  fechaAlta         DateTime @default(now())
  fechaBaja         DateTime?
  
  // Gestión
  ownerId           String?  // ID del gestor de casos
  ownerNombre       String?
  notas             String?  // Notas internas
  tags              String?  // JSON array de tags
  
  // Riesgo del paciente
  riskScore         Int      @default(0)
  riskLevel         String   @default("bajo") // bajo, medio, alto
  riskReasons       String?  // JSON array de motivos
  lastRiskCalculationAt DateTime?
  riskVersion       String?  // Versión de reglas usada
  
  // Flags clínicos
  esCronico         Boolean  @default(false)
  patologias        String?  // JSON array
  
  // Metadatos
  consentimiento    Boolean  @default(false)
  privacidad        Boolean  @default(true)
  
  consultas         Consulta[]
  riskHistory       PatientRiskHistory[]
  quotes            PatientQuote[]
  onboardingCases   OnboardingCase[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([financiadorId, tipoDoc, nroDoc])
  @@unique([financiadorId, nroAfiliado])
  @@index([financiadorId, estadoCobertura])
  @@index([riskLevel])
}

model PatientRiskHistory {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  riskScore         Int
  riskLevel         String
  riskReasons       String?  // JSON array
  riskVersion       String?
  calculatedAt      DateTime @default(now())
  
  @@index([patientId, calculatedAt])
}

model PatientQuote {
  id                String   @id @default(uuid())
  
  // Inputs del cotizador (JSON)
  inputs            String   // JSON con todos los datos ingresados
  
  // Resultados del cálculo
  riskScore         Int      // 0-100
  riskLevel         String   // bajo, medio, alto
  expectedCost12m   Float    // Costo esperado 12 meses
  expectedCostP95    Float    // Costo escenario alto (percentil 95)
  priceCategory     String   // BAJO / MEDIO / ALTO RIESGO
  riskFactor        Float    // Factor de riesgo (ej: 1.0, 1.3, 1.6)
  confidence        String   // Alta / Media / Baja
  reasons           String   // JSON array de explicaciones
  
  // Pricing sugerido
  suggestedPriceMonthly Float?  // Precio mensual sugerido
  priceRangeMin     Float?   // Precio mínimo del rango
  priceRangeMax     Float?   // Precio máximo del rango
  pricingBreakdown  String?  // JSON con breakdown del cálculo
  pricingConfig     String?  // JSON snapshot de la configuración usada
  pricingFlags      String?  // JSON con flags (clamped, low_confidence, etc)
  
  // Workflow de aprobación
  status            String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  approvedByUserId  String?
  approvedBy        User?    @relation("ApprovedQuotes", fields: [approvedByUserId], references: [id])
  createdByUserId   String?  // Usuario que creó la cotización
  createdBy         User?    @relation("CreatedQuotes", fields: [createdByUserId], references: [id])
  
  // Metadatos
  modelVersion      String   @default("1.0")
  patientId         String?  // Se asigna cuando se crea el paciente
  patient           Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  
  // Relaciones
  approvals         QuoteApproval[]
  onboardingCase    OnboardingCase?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([patientId])
  @@index([riskLevel])
  @@index([status])
  @@index([createdByUserId])
}

model OnboardingCase {
  id                      String   @id @default(uuid())
  financiadorId           String?
  financiador             Financiador? @relation(fields: [financiadorId], references: [id])
  patientId               String?
  patient                 Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  quoteId                 String?  @unique
  quote                   PatientQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  
  // Estado del Kanban
  status                  String   @default("PENDIENTE_COTIZACION") // PENDIENTE_COTIZACION, PENDIENTE_APROBACION, APROBADO, PERFIL_COMPLETO, RECHAZADO
  displayName             String   // "Caso #123 - DNI ****"
  
  // Datos para mostrar en card
  riskScore               Int?
  riskLevel               String?  // bajo, medio, alto
  suggestedPriceMonthly   Float?
  
  // Asignación
  assignedToUserId        String?
  assignedTo              User?    @relation("AssignedCases", fields: [assignedToUserId], references: [id])
  createdByUserId         String
  createdBy               User     @relation("CreatedCases", fields: [createdByUserId], references: [id])
  
  // Timestamps
  currentStatusEnteredAt  DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Relaciones
  statusHistory           OnboardingCaseStatusHistory[]
  caseEvents              OnboardingCaseEvent[] @relation("CaseEvents")
  
  @@index([status])
  @@index([financiadorId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([quoteId])
  @@index([patientId])
}

model OnboardingCaseStatusHistory {
  id                String   @id @default(uuid())
  caseId            String
  case              OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus        String?  // null si es primer estado
  toStatus          String
  changedByUserId   String
  changedBy         User     @relation(fields: [changedByUserId], references: [id])
  changedAt         DateTime @default(now())
  note              String?  // Nota opcional del cambio
  durationSeconds   Int?     // Duración en el estado anterior (calculado)
  
  @@index([caseId])
  @@index([changedByUserId])
  @@index([changedAt])
  @@index([toStatus])
}

model OnboardingCaseEvent {
  id                String   @id @default(uuid())
  caseId            String
  case              OnboardingCase @relation("CaseEvents", fields: [caseId], references: [id], onDelete: Cascade)
  eventType         String   // EDIT, STATUS_CHANGE, OVERRIDE
  fromStatus        String?  // Estado anterior del caso
  toStatus          String?  // Estado nuevo del caso (si cambió)
  editedFields      String?  // JSON con campos editados {field: {old, new}}
  reason            String?  // Motivo del cambio (obligatorio en ajustes de aprobador/admin)
  performedByUserId  String
  performedBy       User     @relation("CaseEventPerformedBy", fields: [performedByUserId], references: [id])
  performedAt       DateTime @default(now())
  
  @@index([caseId])
  @@index([performedByUserId])
  @@index([performedAt])
  @@index([eventType])
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String   // bcrypt hash
  role            String   // COTIZADOR, APROBADOR, OFICINA, ADMIN
  financiadorId   String?
  financiador     Financiador? @relation(fields: [financiadorId], references: [id])
  isActive        Boolean  @default(true)
  
  // Relaciones
  createdQuotes   PatientQuote[] @relation("CreatedQuotes")
  approvedQuotes  PatientQuote[] @relation("ApprovedQuotes")
  quoteApprovals QuoteApproval[]
  createdCases    OnboardingCase[] @relation("CreatedCases")
  assignedCases   OnboardingCase[] @relation("AssignedCases")
  caseStatusHistory OnboardingCaseStatusHistory[]
  caseEvents      OnboardingCaseEvent[] @relation("CaseEventPerformedBy")
  audits          Audit[] @relation("AuditCreatedBy")
  importBatches   ImportBatch[] @relation("ImportBatchCreatedBy")
  resolvedFindings AuditFinding[] @relation("FindingResolvedBy")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([email])
  @@index([role])
  @@index([financiadorId])
}

model QuoteApproval {
  id              String   @id @default(uuid())
  quoteId         String
  quote           PatientQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  decision        String   // APPROVED, REJECTED
  reason          String?  // Motivo de rechazo o aprobación
  decidedByUserId String
  decidedBy       User     @relation(fields: [decidedByUserId], references: [id])
  decidedAt       DateTime @default(now())
  
  @@index([quoteId])
  @@index([decidedByUserId])
}

model Prestador {
  id        String     @id @default(uuid())
  nombre    String
  matricula String     @unique
  consultas Consulta[]
}

model Consulta {
  id                String   @id @default(uuid())
  fecha             DateTime
  especialidad      String
  canal             String   // guardia, programada, telemedicina
  costo             Float
  duracion          Int      // minutos
  efectiva          Boolean
  motivoNoEfectiva  String?
  diagnostico       String?
  motivoConsulta    String?
  deriva            Boolean
  tipoDerivacion    String?
  prestadorDerivado String?
  riskScore         Int      @default(0)
  riskLevel         String   @default("bajo") // bajo, medio, alto
  triggeredRules    String?  // JSON array
  trazabilidad      String?  // JSON array
  resumenClinico    String?
  
  // Para POC Auditoría IA
  displayName       String?  // "Caso #1001 - Femenino, 48 años"
  currency          String   @default("ARS")
  providerName      String?  // Nombre prestador (denormalizado para UI)
  auditStatus       String   @default("NOT_AUDITED") // NOT_AUDITED | AUDITED | HAS_FINDINGS
  
  afiliadoId        String?
  afiliado          Afiliado? @relation(fields: [afiliadoId], references: [id])
  
  patientId         String?
  patient           Patient?  @relation(fields: [patientId], references: [id])
  
  prestadorId       String?
  prestador         Prestador? @relation(fields: [prestadorId], references: [id])
  
  financiadorId     String
  financiador       Financiador @relation(fields: [financiadorId], references: [id])
  
  // Importación
  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  
  // Relaciones nuevas
  invoices          ConsultationInvoice[]
  auditFindings     AuditFinding[] @relation("FindingConsultation")
  targetedAudits    Audit[] @relation("AuditTargetConsultation")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([importBatchId])
  @@index([auditStatus])
  @@index([fecha])
  @@index([riskLevel])
}

// --- Módulo Auditoría IA / Consultas-Prácticas (POC Refactored) ---

// ImportBatch: reemplaza DataSource, representa una importación de datos
model ImportBatch {
  id                        String    @id @default(uuid())
  name                      String    // "Importación 29/01 - Facturas+Consultas"
  type                      String    // CONSULTAS | FACTURAS | MIXTA
  status                    String    @default("UPLOADED") // UPLOADED | PROCESSING | READY | ERROR
  recordsCountConsultations Int       @default(0)
  recordsCountInvoices      Int       @default(0)
  uploadedAt                DateTime  @default(now())
  processedAt               DateTime?
  metadata                  String?   // JSON
  createdByUserId           String?
  createdBy                 User?     @relation("ImportBatchCreatedBy", fields: [createdByUserId], references: [id])
  
  // Relaciones
  consultations             Consulta[]
  invoices                  Invoice[]
  
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  
  @@index([status])
  @@index([type])
  @@index([createdByUserId])
}

// Invoice: facturas
model Invoice {
  id              String    @id @default(uuid())
  invoiceNumber   String    // Número de factura
  issuedAt        DateTime  // Fecha emisión
  totalAmount     Float
  currency        String    @default("ARS")
  status          String    @default("RECEIVED") // RECEIVED | VALIDATED | REJECTED | PAID
  providerName    String?   // Prestador
  payerName       String?   // Pagador
  
  // Importación
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  
  // Relaciones
  consultations   ConsultationInvoice[]
  auditFindings   AuditFinding[] @relation("FindingInvoice")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([importBatchId])
  @@index([status])
  @@index([issuedAt])
}

// ConsultationInvoice: relación N:M entre consultas y facturas
model ConsultationInvoice {
  id              String   @id @default(uuid())
  consultationId  String
  consultation    Consulta @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  
  @@unique([consultationId, invoiceId])
  @@index([consultationId])
  @@index([invoiceId])
}

// Audit: auditoría con scope (single, batch, recommended)
model Audit {
  id                      String    @id @default(uuid())
  auditType               String    // FACTURA | PRACTICA | ADMINISTRATIVA | CLINICA
  auditScope              String    @default("BATCH_FILTER") // SINGLE_CONSULTATION | BATCH_FILTER | RECOMMENDED_SET
  status                  String    @default("PENDING") // PENDING | RUNNING | COMPLETED
  
  // Target según scope
  targetConsultationId    String?   // Si scope = SINGLE_CONSULTATION
  targetConsultation      Consulta? @relation("AuditTargetConsultation", fields: [targetConsultationId], references: [id], onDelete: SetNull)
  filterPayload           String?   // JSON: filtros usados si scope = BATCH_FILTER
  recommendedPayload      String?   // JSON: razones si scope = RECOMMENDED_SET
  
  // Resultados
  findingsCountTotal      Int       @default(0)
  findingsCountHigh       Int       @default(0)
  findingsCountMedium     Int       @default(0)
  findingsCountLow        Int       @default(0)
  estimatedSavings        Float     @default(0) // Mock: ahorro estimado
  consultationsAudited    Int       @default(0) // Cantidad de consultas auditadas
  
  // Usuario
  createdByUserId         String
  createdBy               User      @relation("AuditCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  
  // Timestamps
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  // Relaciones
  findings                AuditFinding[]
  
  @@index([createdByUserId])
  @@index([status])
  @@index([auditScope])
  @@index([auditType])
}

// AuditFinding: hallazgo de auditoría
model AuditFinding {
  id              String    @id @default(uuid())
  auditId         String
  audit           Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  // Entidad asociada
  consultationId  String?
  consultation    Consulta? @relation("FindingConsultation", fields: [consultationId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?  @relation("FindingInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  
  // Datos del hallazgo
  severity        String    // LOW | MEDIUM | HIGH
  category        String    // DUPLICADO | INCONSISTENCIA | SOBREPRACTICA | CLINICA | ADMIN
  title           String    // Título corto
  description     String    // Descripción detallada
  evidence        String?   // JSON: campos que sustentan el hallazgo
  confidence      Float     // 0-1
  suggestedAction String?
  
  // Workflow
  status          String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED
  resolvedAt      DateTime?
  resolvedByUserId String?
  resolvedBy      User?     @relation("FindingResolvedBy", fields: [resolvedByUserId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([auditId])
  @@index([consultationId])
  @@index([invoiceId])
  @@index([severity])
  @@index([category])
  @@index([status])
}

// Mantener DataSource y PopulationModel por compatibilidad (deprecated)
model DataSource {
  id            String    @id @default(uuid())
  name          String
  type          String
  status        String    @default("UPLOADED")
  recordsCount  Int       @default(0)
  uploadedAt    DateTime  @default(now())
  processedAt   DateTime?
  metadata      String?
  financiadorId String?
  financiador   Financiador? @relation(fields: [financiadorId], references: [id], onDelete: SetNull)
  populationModels PopulationModel[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([status])
}

model PopulationModel {
  id            String   @id @default(uuid())
  sourceId      String
  source        DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  modelType     String
  status        String   @default("READY")
  entitiesCount Int      @default(0)
  createdAt     DateTime @default(now())
  @@index([sourceId])
}
